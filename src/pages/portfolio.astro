---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PitchBand from '../components/PitchBand.astro';
import { portfolio } from '../data/portfolio';

const exitCount = portfolio.filter((c) => c.exited).length;
const roleNote: Record<string, string> = {
  Built: 'We built it',
  'Co-founded': 'We co-founded it',
  'Seed and advisory': 'Seed funding and advice',
  Partner: 'Partner company',
};
---
<Base title="Portfolio" description="Companies Team Africa Ventures has built, co-founded and backed, including Twangoo, Lula, Conversio, Click2Sure and Hyperli.">
  <PageHero
    label="Portfolio"
    title="The companies we have built and backed."
    intro="Some we started ourselves. Others we funded and worked inside from the first cheque. Here is the list, with what happened next."
    parts={['seed', 'founder']}
  />

  <section class="section portfolio">
    <div class="wrap">
      <div class="filter" role="group" aria-label="Filter companies">
        <button type="button" class="filter__btn" data-filter="all" aria-pressed="true">
          All companies <span class="filter__count">{portfolio.length}</span>
        </button>
        <button type="button" class="filter__btn" data-filter="exited" aria-pressed="false">
          Exits <span class="filter__count">{exitCount}</span>
        </button>
      </div>
      <p class="visually-hidden" aria-live="polite" id="filter-status"></p>

      <ul class="index">
        {portfolio.map((c) => (
          <li class="index__row" data-exited={c.exited ? 'true' : 'false'}>
            <div class="index__name">
              <h2>
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener noreferrer">
                    {c.name}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                ) : (
                  c.name
                )}
              </h2>
              {c.sector && <p class="index__sector">{c.sector}</p>}
            </div>
            <p class="index__summary">{c.summary ?? ''}</p>
            <dl class="index__meta">
              <div>
                <dt>Our role</dt>
                <dd>{roleNote[c.role]}{c.started ? `, ${c.started}` : ''}</dd>
              </div>
              {c.outcome && (
                <div>
                  <dt>Outcome</dt>
                  <dd class:list={{ 'is-exit': c.exited }}>{c.outcome}</dd>
                </div>
              )}
            </dl>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <PitchBand />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter__btn');
  const rows = document.querySelectorAll<HTMLElement>('.index__row');
  const status = document.getElementById('filter-status');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      rows.forEach((row) => {
        const show = f === 'all' || row.dataset.exited === 'true';
        row.hidden = !show;
        if (show) shown++;
      });
      if (status) status.textContent = `Showing ${shown} ${f === 'all' ? 'companies' : 'exits'}`;
    });
  });
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }
  .filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--navy);
    font: inherit;
    font-size: 1rem;
    font-weight: 560;
    cursor: pointer;
  }
  .filter__btn[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--on-dark);
  }
  .filter__count {
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .index__row {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 1.6fr) minmax(12rem, 1fr);
    gap: 0.75rem 2.5rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  .index__row[hidden] {
    display: none;
  }
  .index__name h2 {
    font-size: var(--step-2);
    font-weight: 300;
    letter-spacing: -0.015em;
  }
  .index__name a {
    text-decoration: none;
    background-image: linear-gradient(var(--peach), var(--peach));
    background-size: 0 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 200ms ease;
  }
  .index__name a:hover {
    background-size: 100% 1px;
  }
  .index__sector {
    margin-top: 0.35rem;
    font-size: 1rem;
    color: var(--indigo);
    font-weight: 560;
  }
  .index__summary {
    color: var(--ink-soft);
    max-width: 52ch;
  }
  .index__meta {
    margin: 0;
    display: grid;
    gap: 0.6rem;
    font-size: 1rem;
  }
  .index__meta dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .index__meta dd {
    margin: 0;
    font-weight: 560;
  }
  .index__meta dd.is-exit::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--ember);
    vertical-align: 0.1em;
  }
  @media (max-width: 63.99rem) {
    .index__row {
      grid-template-columns: 1fr;
    }
  }
</style>
