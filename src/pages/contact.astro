---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site, audiences } from '../data/site';

const asks: Record<string, string> = {
  founders: 'Tell us which service you would replace, what you know about it from the inside, and why now.',
  operators: 'Tell us which service business you have run, what you would automate first, and whether you want to lead the company.',
  investors: 'Tell us how you invest, your typical cheque, and which markets you know well.',
};
const roleLabel: Record<string, string> = { founders: 'Founder', operators: 'Operator', investors: 'Co-investor' };
---
<Base title="Contact" description="Build with Team Africa Ventures: founders, operators and co-investors, start here." footerCta={false}>
  <PageHero
    label="Contact"
    title="Start a build with us."
    intro="Founders, operators and co-investors all start the same way: a short email. Pick who you are and we will tell you what to include."
    parts={['seed', 'founder', 'partner']}
  />

  <section class="section" aria-labelledby="who-h">
    <div class="wrap">
      <h2 id="who-h" class="visually-hidden">Who are you?</h2>
      <ul class="who">
        {audiences.map((a) => (
          <li id={a.id} class="who__item">
            <h3>{a.who}</h3>
            <p class="who__line">{a.line}</p>
            <p class="who__ask">{asks[a.id]}</p>
            <a class="link-arrow" href="#compose" data-role={roleLabel[a.id]}>Write as {roleLabel[a.id].toLowerCase()}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-alt" id="compose" aria-labelledby="compose-h">
    <div class="wrap split">
      <div>
        <p class="label">Write to us</p>
        <h2 id="compose-h" class="h-section">Draft your email here.</h2>
        <p class="compose__note">
          This opens your email app with everything filled in. Nothing is sent until you press send
          there. Prefer to write it yourself? Use the address below.
        </p>
        <div class="address">
          <a class="address__email" href={`mailto:${site.email}`}>{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</a>
          <button class="btn btn--ghost copy" type="button" data-copy={site.email}>Copy address</button>
          <span class="copy__status" role="status" aria-live="polite"></span>
        </div>
      </div>

      <form class="compose" id="compose-form" novalidate>
        <fieldset class="compose__roles">
          <legend>I am a</legend>
          {Object.values(roleLabel).map((r, i) => (
            <label class="chip">
              <input type="radio" name="role" value={r} checked={i === 0} />
              <span>{r.toLowerCase()}</span>
            </label>
          ))}
        </fieldset>

        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required />
          <p class="field__error" id="f-name-err" hidden>Add your name so we know who is writing.</p>
        </div>
        <div class="field">
          <label for="f-industry">Which service industry would you rebuild?</label>
          <input id="f-industry" name="industry" type="text" placeholder="For example: insurance claims handling" />
        </div>
        <div class="field">
          <label for="f-link">Link to a deck, site or profile <span class="field__opt">(optional)</span></label>
          <input id="f-link" name="link" type="url" inputmode="url" placeholder="https://" />
        </div>
        <div class="field">
          <label for="f-msg">What should we know?</label>
          <textarea id="f-msg" name="message" rows="6" aria-describedby="f-msg-hint"></textarea>
          <p class="field__hint" id="f-msg-hint">{asks.founders}</p>
        </div>
        <button class="btn btn--solid" type="submit">Open in my email app</button>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email, asks }}>
  const form = document.getElementById('compose-form');
  const hint = document.getElementById('f-msg-hint');
  const askFor = { Founder: asks.founders, Operator: asks.operators, 'Co-investor': asks.investors };

  const setRole = (role) => {
    const input = form.querySelector(`input[name="role"][value="${role}"]`);
    if (input) {
      input.checked = true;
      hint.textContent = askFor[role];
    }
  };

  form.addEventListener('change', (e) => {
    if (e.target.name === 'role') hint.textContent = askFor[e.target.value];
  });

  // Arriving from "Founders / Operators / Co-investors" links pre-selects the role.
  const fromHash = { '#founders': 'Founder', '#operators': 'Operator', '#investors': 'Co-investor' }[location.hash];
  if (fromHash) setRole(fromHash);
  document.querySelectorAll('a[data-role]').forEach((a) =>
    a.addEventListener('click', () => setRole(a.dataset.role)),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') || '').trim();
    const err = document.getElementById('f-name-err');
    const nameInput = document.getElementById('f-name');
    if (!name) {
      err.hidden = false;
      nameInput.setAttribute('aria-invalid', 'true');
      nameInput.setAttribute('aria-describedby', 'f-name-err');
      nameInput.focus();
      return;
    }
    err.hidden = true;
    nameInput.removeAttribute('aria-invalid');
    const role = data.get('role');
    const industry = String(data.get('industry') || '').trim();
    const link = String(data.get('link') || '').trim();
    const msg = String(data.get('message') || '').trim();
    const subject = `${role}: ${industry || 'building with TAV'}`;
    const lines = [`Name: ${name}`, `I am a: ${role}`];
    if (industry) lines.push(`Industry to rebuild: ${industry}`);
    if (link) lines.push(`Link: ${link}`);
    if (msg) lines.push('', msg);
    const body = lines.join('\n');
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  document.querySelectorAll('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const status = btn.parentElement.querySelector('.copy__status');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        btn.textContent = 'Copied';
        status.textContent = 'Email address copied';
      } catch {
        status.textContent = 'Copy failed. Select the address instead.';
      }
      setTimeout(() => (btn.textContent = 'Copy address'), 2400);
    });
  });
</script>

<style>
  .who {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 4vw, 3rem);
  }
  .who__item {
    padding-top: 1.5rem;
    border-top: 2px solid var(--text);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .who__item:target {
    border-top-color: var(--peach);
  }
  .who h3 {
    font-size: var(--step-2);
    font-weight: 320;
    margin-bottom: 0.75rem;
  }
  .who__line {
    font-weight: 520;
    margin-bottom: 0.75rem;
  }
  .who__ask {
    color: var(--text-soft);
    margin-bottom: 1.25rem;
  }

  .compose__note {
    margin-top: 1.5rem;
    color: var(--text-soft);
    max-width: 38ch;
  }
  .address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }
  .address__email {
    font-size: clamp(1.25rem, 0.8rem + 1.6vw, 1.75rem);
    font-weight: 320;
    overflow-wrap: anywhere;
    width: 100%;
  }
  .copy__status {
    font-size: 0.95rem;
    color: var(--text-soft);
  }

  .compose {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .compose__roles {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .compose__roles legend {
    font-weight: 600;
    margin-bottom: 0.6rem;
    padding: 0;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-weight: 560;
  }
  .chip input:checked + span {
    background: var(--btn-bg);
    border-color: var(--btn-bg);
    color: var(--btn-ink);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-weight: 600;
  }
  .field__opt {
    font-weight: 420;
    color: var(--text-soft);
  }
  .field input,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 1.05rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem 0.9rem;
    min-height: 3rem;
  }
  .field input::placeholder {
    color: var(--text-soft);
    opacity: 0.8;
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .field input[aria-invalid='true'] {
    border-color: var(--ember);
  }
  .field__hint {
    font-size: 0.95rem;
    color: var(--text-soft);
  }
  .field__error {
    font-size: 0.95rem;
    color: light-dark(#b23a17, #ff9f7f);
    font-weight: 600;
  }
  .compose .btn {
    justify-self: start;
  }
  @media (max-width: 63.99rem) {
    .who {
      grid-template-columns: 1fr;
    }
  }
</style>
