---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { stats, audiences } from '../data/site';
import { portfolio } from '../data/portfolio';
import { thesis } from '../data/approach';

const featuredNames = ['Twangoo', '5 Ounces', 'Glambox', 'Lula', 'Conversio', 'Click2Sure', 'WumDrop', 'Hyperli'];
const featured = featuredNames.map((n) => portfolio.find((c) => c.name === n)!);

const what: Array<{ title: string; body: string; cta: string; href: string; parts: Array<'seed' | 'founder' | 'partner'> }> = [
  {
    title: 'Build',
    body: 'We start before day one. We find a service market that still runs on headcount and build the AI-first company that replaces it, together with a founder.',
    cta: 'How we build',
    href: '/approach/',
    parts: ['seed'],
  },
  {
    title: 'Back',
    body: 'We put in our own capital and stay in the work: co-builders, our AI operating stack and our network, not a cheque and a quarterly call.',
    cta: 'Our companies',
    href: '/portfolio/',
    parts: ['seed', 'founder'],
  },
  {
    title: 'Scale',
    body: 'Revenue grows faster than the team. We automate before we hire, sell beyond the home market early, and hand over deliberately.',
    cta: 'Work with us',
    href: '/contact/',
    parts: ['seed', 'founder', 'partner'],
  },
];
---
<Base footerCta={false}>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__inner">
      <Mark strokeWidth={3} draw idPrefix="hero" class="hero__mark" title="Team Africa Ventures" />
      <h1 class="hero__title">We build <span class="nowrap">AI-first</span> companies.</h1>
      <p class="hero__lede">
        Team Africa Ventures is an operator-led venture studio. We build with founders from day zero
        to replace manual, people-heavy service businesses, with small teams and a global market.
      </p>
    </div>
    <span class="hero__line" aria-hidden="true"></span>
  </section>

  <!-- What we do -->
  <section class="section on-alt" aria-labelledby="what-h">
    <div class="wrap">
      <h2 id="what-h" class="visually-hidden">What we do</h2>
      <ul class="what">
        {what.map((w, i) => (
          <li class="what__item">
            <Mark parts={w.parts} strokeWidth={6} idPrefix={`what${i}`} class="what__icon" />
            <h3>{w.title}</h3>
            <p>{w.body}</p>
            <a class="btn" href={w.href}>{w.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Companies -->
  <section class="section" aria-labelledby="companies-h">
    <div class="wrap">
      <p class="label">Track record</p>
      <h2 id="companies-h" class="h-section">Our companies</h2>
      <dl class="ledger">
        {stats.map((s) => (
          <div class="ledger__box">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>

      <ul class="grid">
        {featured.map((c) => (
          <li class="grid__cell">
            <p class="grid__name">{c.name}</p>
            {c.sector && <p class="grid__sector">{c.sector}</p>}
            <p class:list={['grid__outcome', { 'is-exit': c.exited }]}>{c.outcome ?? 'Active'}</p>
          </li>
        ))}
      </ul>
      <div class="companies__more">
        <a class="btn" href="/portfolio/">All companies</a>
      </div>
    </div>
  </section>

  <!-- Statement -->
  <section class="statement on-alt" aria-labelledby="believe-h">
    <div class="wrap statement__inner">
      <h2 id="believe-h" class="visually-hidden">What we believe</h2>
      <blockquote class="statement__quote">
        <p>{thesis.statement}</p>
      </blockquote>
      <ul class="principles">
        {thesis.principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Start here -->
  <section class="section" aria-labelledby="start-h">
    <div class="wrap">
      <p class="label">Work with us</p>
      <h2 id="start-h" class="h-section">Start here</h2>
      <nav aria-label="Start here">
        <ul class="paths">
          {audiences.map((a) => (
            <li>
              <a href={`/contact/#${a.id}`} class="path">
                <span class="path__who">{a.who}</span>
                <span class="path__line">{a.line}</span>
                <span class="path__cta">{a.cta}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(3.5rem, 8vw, 6.5rem));
    padding-bottom: clamp(5rem, 10vw, 8rem);
    text-align: center;
  }
  .hero__inner {
    display: grid;
    justify-items: center;
  }
  .hero :global(.hero__mark) {
    width: min(22rem, 70vw);
    height: auto;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .hero__title {
    font-size: clamp(2.6rem, 1.2rem + 5.4vw, 6rem);
    letter-spacing: -0.035em;
    line-height: 1;
    max-width: 17ch;
  }
  .nowrap {
    white-space: nowrap;
  }
  .hero__lede {
    margin-top: 1.75rem;
    max-width: 48ch;
    color: var(--text-soft);
    font-size: var(--step-0);
  }
  .hero__line {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: clamp(3rem, 6vw, 4.5rem);
    background: var(--line-strong);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lede {
      animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__title {
      animation-delay: 700ms;
    }
    .hero__lede {
      animation-delay: 850ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* What we do */
  .what {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 5vw, 4.5rem);
  }
  .what__item {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    justify-items: start;
  }
  .what__item :global(.what__icon) {
    width: 6.5rem;
    height: auto;
    margin-bottom: 1.75rem;
    color: var(--ink);
  }
  .what h3 {
    font-size: var(--step-2);
    margin-bottom: 0.9rem;
  }
  .what p {
    color: var(--text-soft);
    margin-bottom: 1.75rem;
  }

  /* Companies */
  .ledger {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }
  .ledger__box {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.25rem 1.4rem;
    border: 1px solid var(--line);
  }
  .ledger dd {
    order: -1;
    margin: 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ledger dt {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-soft);
    line-height: 1.4;
  }
  .grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .grid__cell {
    padding: 1.5rem 1.25rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .grid__name {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .grid__sector {
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--text-soft);
  }
  .grid__outcome {
    margin-top: 0.9rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .grid__outcome.is-exit::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--ember);
    vertical-align: 0.05em;
  }
  .companies__more {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }

  /* Statement */
  .statement {
    padding-block: var(--section);
  }
  .statement__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .statement__quote {
    margin: 0;
    max-width: 50rem;
  }
  .statement__quote p {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.4rem);
    line-height: 1.35;
    color: var(--ink);
    font-weight: 400;
  }
  .principles {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem clamp(2rem, 4vw, 3.5rem);
    text-align: left;
    width: 100%;
  }
  .principles li {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-strong);
  }
  .principles h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .principles p {
    color: var(--text-soft);
    font-size: 1rem;
  }

  /* Start here */
  .paths {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .path {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
    height: 100%;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }
  .path__who {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--ink);
    letter-spacing: -0.015em;
  }
  .path__line {
    color: var(--text-soft);
  }
  .path__cta {
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .path:hover {
    background: var(--btn-bg);
  }
  .path:hover .path__who,
  .path:hover .path__line,
  .path:hover .path__cta {
    color: var(--btn-ink);
  }

  @media (max-width: 63.99rem) {
    .ledger {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 47.99rem) {
    .what,
    .principles,
    .paths {
      grid-template-columns: 1fr;
    }
    .ledger {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
