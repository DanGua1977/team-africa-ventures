---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { stats, audiences } from '../data/site';
import { portfolio } from '../data/portfolio';
import { thesis, comparison, focusAreas, bestFor, stages } from '../data/approach';

const storyNames = ['Twangoo', 'Glambox', 'Lula', 'Conversio', 'Click2Sure', 'Hyperli', 'WumDrop'];
const stories = storyNames.map((n) => portfolio.find((c) => c.name === n)!);

const stageParts: Array<Array<'seed' | 'founder' | 'partner'>> = [
  ['seed'],
  ['seed', 'founder'],
  ['seed', 'founder', 'partner'],
];
---
<Base>
  <!-- Hero -->
  <section class="hero on-dark">
    <div class="hero__art" aria-hidden="true">
      <Mark strokeWidth={1.1} draw idPrefix="hero" />
    </div>
    <div class="wrap hero__inner">
      <p class="hero__kicker"><span class="hero__dot" aria-hidden="true"></span>Venture studio, run by operators</p>
      <h1 class="hero__title">We build the AI-first companies that replace service incumbents.</h1>
      <p class="lede hero__lede">
        We build with founders from day zero. Software does the work, a small team makes the calls,
        and the market is global.
      </p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="/contact/#founders">Build with us</a>
        <a class="btn btn--ghost" href="/approach/">How we build</a>
      </div>
    </div>

    <nav class="wrap paths" aria-label="Start here">
      <ul>
        {audiences.map((a) => (
          <li>
            <a href={`/contact/#${a.id}`} class="path">
              <span class="path__who">{a.who}</span>
              <span class="path__line">{a.line}</span>
              <span class="path__cta">{a.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <!-- Thesis -->
  <section class="section" aria-labelledby="thesis-h">
    <div class="wrap">
      <p class="label" id="thesis-h">What we believe</p>
      <p class="thesis__statement">{thesis.statement}</p>
      <ul class="principles">
        {thesis.principles.map((p) => (
          <li>
            <h2 class="principles__title">{p.title}</h2>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Studio vs fund -->
  <section class="section on-alt" aria-labelledby="compare-h">
    <div class="wrap">
      <p class="label">Studio, not fund</p>
      <h2 id="compare-h" class="h-section">We would rather build it with you than wire money and wait.</h2>
      <div class="compare" role="region" aria-label="Seed fund and studio compared" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Question</span></th>
              <th scope="col">{comparison.columns[0]}</th>
              <th scope="col" class="compare__us">{comparison.columns[1]}</th>
            </tr>
          </thead>
          <tbody>
            {comparison.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.fund}</td>
                <td class="compare__us">{r.tav}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Focus and best for -->
  <section class="section" aria-labelledby="focus-h">
    <div class="wrap split">
      <div>
        <p class="label">Where we build</p>
        <h2 id="focus-h" class="h-section">Large service markets that still run on headcount.</h2>
        <div class="bestfor">
          <h3>Best for</h3>
          <ul>
            {bestFor.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
      <ul class="rule-list focus">
        {focusAreas.map((f) => (
          <li>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section class="section on-alt" aria-labelledby="process-h">
    <div class="wrap">
      <p class="label">How a company gets built</p>
      <h2 id="process-h" class="h-section">Three stages, from weak point to scale.</h2>
      <ol class="stages">
        {stages.map((s, i) => (
          <li class="stage">
            <Mark parts={stageParts[i]} strokeWidth={4} class="stage__mark" idPrefix={`st${i}`} />
            <p class="stage__num">Stage {i + 1}</p>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ol>
      <a class="link-arrow process__more" href="/approach/">See the questions we ask at each stage</a>
    </div>
  </section>

  <!-- Track record -->
  <section class="section on-dark record" aria-labelledby="record-h">
    <div class="wrap split">
      <div>
        <p class="label">Track record</p>
        <h2 id="record-h" class="h-section">We have built, backed and sold before.</h2>
        <p class="record__note">
          Companies we built or backed have been acquired by Groupon, Naspers, Campaign Monitor and
          Massmart. We bring that experience into every build.
        </p>
      </div>
      <dl class="ledger">
        {stats.map((s) => (
          <div class="ledger__row">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Stories -->
  <section class="section" aria-labelledby="stories-h">
    <div class="wrap">
      <div class="stories__head">
        <div>
          <p class="label">Selected companies</p>
          <h2 id="stories-h" class="h-section">Where the experience comes from.</h2>
        </div>
        <a class="btn btn--ghost" href="/portfolio/">Full portfolio</a>
      </div>
      <ol class="timeline">
        {stories.map((c) => (
          <li class="timeline__row">
            <span class="timeline__year">{c.started ?? ''}</span>
            <h3 class="timeline__name">{c.name}</h3>
            <p class="timeline__summary">{c.summary}</p>
            <p class:list={['timeline__outcome', { 'is-exit': c.exited }]}>{c.outcome ?? 'Active'}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 60rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + 4rem);
  }
  .hero__art {
    position: absolute;
    top: 46%;
    right: -18vw;
    width: min(60rem, 56vw);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1rem;
    font-weight: 560;
    color: var(--text-soft);
    margin-bottom: 1.75rem;
  }
  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 4px rgba(127, 220, 224, 0.18);
  }
  .hero__title {
    font-size: clamp(2.9rem, 1.4rem + 5.2vw, 6.25rem);
    font-weight: 230;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 13ch;
  }
  .hero__lede {
    margin-top: 2rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }

  .paths {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .paths ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .paths li + li {
    border-left: 1px solid var(--line);
  }
  .path {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.35rem;
    height: 100%;
    padding: 1.5rem 1.5rem 1.25rem;
    text-decoration: none;
    transition: background-color 180ms ease;
  }
  .paths li:first-child .path {
    padding-left: 0;
  }
  .path:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .path__who {
    font-size: var(--step-1);
    font-weight: 380;
  }
  .path__line {
    color: var(--text-soft);
    font-size: 1rem;
    max-width: 32ch;
  }
  .path__cta {
    margin-top: 0.5rem;
    font-size: 1rem;
    font-weight: 620;
    color: var(--peach);
  }
  .path:hover .path__cta {
    text-decoration: underline;
  }

  @media (max-width: 63.99rem) {
    .hero__art {
      top: calc(var(--header-h) + 1rem);
      right: -45vw;
      width: 115vw;
      transform: none;
      opacity: 0.3;
    }
  }
  @media (max-width: 47.99rem) {
    .paths ul {
      grid-template-columns: 1fr;
    }
    .paths li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .path {
      padding-inline: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__title,
    .hero__lede,
    .hero__actions,
    .paths {
      animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__title {
      animation-delay: 60ms;
    }
    .hero__lede {
      animation-delay: 140ms;
    }
    .hero__actions {
      animation-delay: 220ms;
    }
    .paths {
      animation-delay: 420ms;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Thesis */
  .thesis__statement {
    font-size: var(--step-3);
    font-weight: 280;
    line-height: 1.16;
    letter-spacing: -0.015em;
    max-width: 28ch;
  }
  .principles {
    list-style: none;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 4vw, 3.5rem);
  }
  .principles li {
    padding-top: 1.5rem;
    border-top: 2px solid var(--text);
  }
  .principles__title {
    font-size: var(--step-2);
    font-weight: 340;
    margin-bottom: 0.9rem;
  }
  .principles p {
    color: var(--text-soft);
    max-width: 34ch;
  }

  /* Comparison */
  .compare {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    overflow-x: auto;
  }
  .compare table {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
  }
  .compare th,
  .compare td {
    text-align: left;
    vertical-align: top;
    padding: 1.15rem 1.25rem 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .compare thead th {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--text-soft);
    border-bottom-color: var(--text);
  }
  .compare tbody th {
    font-weight: 560;
    width: 26%;
  }
  .compare td {
    color: var(--text-soft);
    width: 34%;
  }
  .compare td.compare__us {
    color: var(--text);
    font-weight: 520;
  }
  .compare thead .compare__us {
    color: var(--accent);
  }

  /* Focus */
  .bestfor {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border-radius: 18px;
    background: var(--bg-alt);
  }
  .bestfor h3 {
    font-size: 1rem;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .bestfor ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .focus h3 {
    font-size: var(--step-1);
    font-weight: 400;
  }

  /* Process */
  .stages {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem clamp(1.5rem, 4vw, 4rem);
  }
  .stage :global(.stage__mark) {
    width: 9.5rem;
    height: auto;
    margin-bottom: 2rem;
    color: var(--text);
  }
  .stage__num {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .stage h3 {
    font-size: var(--step-1);
    font-weight: 420;
    margin-bottom: 0.6rem;
  }
  .stage p:last-child {
    color: var(--text-soft);
    max-width: 30ch;
  }
  .process__more {
    display: inline-block;
    margin-top: 3rem;
  }

  /* Track record */
  .record__note {
    margin-top: 1.5rem;
    color: var(--text-soft);
    max-width: 36ch;
  }
  .ledger {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .ledger__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .ledger dt {
    color: var(--text-soft);
    max-width: 26ch;
  }
  .ledger dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 250;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--peach);
  }

  /* Stories */
  .stories__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .timeline__row {
    display: grid;
    grid-template-columns: 5rem minmax(9rem, 1fr) minmax(0, 2.2fr) minmax(0, 1.2fr);
    gap: 0.5rem 2rem;
    align-items: baseline;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
  }
  .timeline__year {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--accent);
  }
  .timeline__name {
    font-size: var(--step-2);
    font-weight: 320;
    letter-spacing: -0.015em;
  }
  .timeline__summary {
    color: var(--text-soft);
    max-width: 52ch;
  }
  .timeline__outcome {
    font-weight: 560;
    font-size: 1rem;
  }
  .timeline__outcome.is-exit::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--ember);
    vertical-align: 0.1em;
  }

  @media (max-width: 63.99rem) {
    .timeline__row {
      grid-template-columns: 4rem 1fr;
    }
    .timeline__summary,
    .timeline__outcome {
      grid-column: 2;
    }
  }
  @media (max-width: 47.99rem) {
    .principles,
    .stages {
      grid-template-columns: 1fr;
    }
  }
</style>
