---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" footerCta={false}>
  <PageHero
    label="404"
    title="That page is not here."
    intro="The link may be old or mistyped. Start from the home page, or go straight to the portfolio."
    parts={['seed']}
  >
    <div class="nf-actions">
      <a class="btn btn--solid" href="/">Go to the home page</a>
      <a class="btn btn--ghost" href="/portfolio/">See the portfolio</a>
    </div>
  </PageHero>
</Base>

<style>
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.5rem;
  }
</style>
