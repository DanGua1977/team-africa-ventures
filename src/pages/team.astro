---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { partners, team, widerTeam, SHOW_WIDER_TEAM, type Person } from '../data/team';

const initial = (p: Person) => p.name.trim().charAt(0).toUpperCase();
---
<Base title="Team" description="The operators behind Team Africa Ventures: the founders of Twangoo and former leaders of Groupon South Africa, now building AI-first companies.">
  <PageHero
    label="Team"
    title="Operators first, investors second."
    intro="Between us we have more than 30 years in business and more than 30 start-ups behind us. We have sold our own companies, run large teams, and now build companies that need far smaller ones."
    parts={['founder', 'partner']}
  />

  <section class="section" aria-labelledby="partners-h">
    <div class="wrap">
      <h2 id="partners-h" class="visually-hidden">Partners</h2>
      <ul class="people">
        {partners.map((p) => (
          <li class="person">
            <div class="avatar">
              {p.photo ? (
                <img src={p.photo} alt={`Portrait of ${p.name}`} width="300" height="300" loading="lazy" decoding="async" />
              ) : (
                <span class="avatar__mono" aria-hidden="true">{initial(p)}</span>
              )}
            </div>
            <div class="person__body">
              <h3>{p.name}</h3>
              <p class="person__role">{p.role}</p>
              {p.bio.map((para) => <p class="person__bio">{para}</p>)}
              {p.linkedin && (
                <a class="link-arrow person__link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
                  {p.name} on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section on-alt" aria-labelledby="team-h">
    <div class="wrap">
      <p class="label">The studio</p>
      <h2 id="team-h" class="h-section">A small team, by design.</h2>
      <ul class="crew">
        {team.map((p) => (
          <li class="crew__item">
            <div class="avatar avatar--sm">
              {p.photo ? (
                <img src={p.photo} alt={`Portrait of ${p.name}`} width="160" height="160" loading="lazy" decoding="async" />
              ) : (
                <span class="avatar__mono" aria-hidden="true">{initial(p)}</span>
              )}
            </div>
            <div>
              <h3>{p.name}</h3>
              <p class="person__role">{p.role}</p>
              {p.bio.map((para) => <p class="person__bio">{para}</p>)}
            </div>
          </li>
        ))}
        {SHOW_WIDER_TEAM &&
          widerTeam.map((m) => (
            <li class="crew__item">
              <div>
                <h3>{m.name}</h3>
                <p class="person__role">{m.role}</p>
              </div>
            </li>
          ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }
  .person {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  /* Portrait framed like the seed circle in the mark: a thin gradient ring. */
  .avatar {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    border-radius: 50%;
    padding: 3px;
    background: linear-gradient(135deg, var(--peach), #5563c9 55%, var(--cyan));
  }
  .avatar img,
  .avatar__mono {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg);
  }
  .avatar img {
    filter: grayscale(1) contrast(1.05);
  }
  .avatar__mono {
    display: grid;
    place-items: center;
    background: var(--night);
    color: #fff;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 220;
  }
  .on-alt .avatar img,
  .on-alt .avatar__mono {
    border-color: var(--bg-alt);
  }
  .person h3 {
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .person__role {
    margin-top: 0.4rem;
    margin-bottom: 1.25rem;
    font-weight: 600;
    color: var(--accent);
  }
  .person__bio {
    max-width: 60ch;
    color: var(--text-soft);
  }
  .person__bio + .person__bio {
    margin-top: 1rem;
  }
  .person__link {
    display: inline-block;
    margin-top: 1.5rem;
  }
  .crew {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 2.5rem;
  }
  .crew__item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .avatar--sm .avatar__mono {
    font-size: 2.25rem;
  }
  .crew h3 {
    font-size: var(--step-1);
    font-weight: 400;
  }
  .crew .person__role {
    margin-bottom: 0.6rem;
  }
  @media (max-width: 47.99rem) {
    .person {
      grid-template-columns: 1fr;
    }
    .person .avatar {
      max-width: 11rem;
    }
  }
</style>
