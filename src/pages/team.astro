---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PitchBand from '../components/PitchBand.astro';
import { partners, widerTeam, SHOW_WIDER_TEAM } from '../data/team';
---
<Base title="Team" description="The partners behind Team Africa Ventures: operators who co-founded Twangoo, ran Groupon South Africa and have built, backed and sold companies since.">
  <PageHero
    label="Team"
    title="Operators first, investors second."
    intro="Between us we have more than 30 years in business and more than 30 start-ups behind us. We have sold our own companies and run large teams through growth. That is the experience we bring to every company we work with."
    parts={['founder', 'partner']}
  />

  <section class="section">
    <div class="wrap">
      <ul class="partners">
        {partners.map((p) => (
          <li class="partner">
            <img
              class="partner__photo"
              src={p.photo}
              alt={`Portrait of ${p.name}`}
              width="300"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="partner__body">
              <h2>{p.name}</h2>
              <p class="partner__role">{p.role}</p>
              {p.bio.map((para) => <p class="partner__bio">{para}</p>)}
              {p.linkedin && (
                <a class="partner__link" href={p.linkedin} target="_blank" rel="noopener noreferrer">
                  {p.name} on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>

      {SHOW_WIDER_TEAM && (
        <div class="wider">
          <h2>The wider team</h2>
          <ul>
            {widerTeam.map((m) => (
              <li>
                <span class="wider__name">{m.name}</span>
                <span class="wider__role">{m.role}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <PitchBand title="Want to build with us?" body="Founders, operators and co-investors: if you think we should work together, send us a note with what you have in mind." />
</Base>

<style>
  .partners {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
  }
  .partner {
    display: grid;
    grid-template-columns: minmax(10rem, 17rem) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .partner__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    filter: grayscale(1) contrast(1.05);
  }
  .partner h2 {
    font-size: var(--step-3);
  }
  .partner__role {
    margin-top: 0.5rem;
    margin-bottom: 1.75rem;
    font-weight: 600;
    color: var(--indigo);
  }
  .partner__bio {
    max-width: 60ch;
    color: var(--ink-soft);
  }
  .partner__bio + .partner__bio {
    margin-top: 1rem;
  }
  .partner__link {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 600;
  }
  .wider {
    margin-top: clamp(4rem, 8vw, 6rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .wider h2 {
    font-size: var(--step-2);
    margin-bottom: 1.5rem;
  }
  .wider ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1.25rem 2rem;
  }
  .wider__name {
    display: block;
    font-weight: 600;
  }
  .wider__role {
    color: var(--ink-soft);
  }
  @media (max-width: 47.99rem) {
    .partner {
      grid-template-columns: 1fr;
    }
    .partner__photo {
      max-width: 11rem;
    }
  }
</style>
