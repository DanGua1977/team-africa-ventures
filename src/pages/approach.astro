---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PitchBand from '../components/PitchBand.astro';
import Mark from '../components/Mark.astro';
import { modes, platform, stages, criteria } from '../data/approach';

const stageParts: Array<Array<'seed' | 'founder' | 'partner'>> = [
  ['seed'],
  ['seed', 'founder'],
  ['seed', 'founder', 'partner'],
];
---
<Base title="Approach" description="How Team Africa Ventures builds and backs companies: two ways we work, the platform founders get, our three-stage process and what we look for.">
  <PageHero
    label="Approach"
    title="We work inside the business, not beside it."
    intro="With a deep understanding of the South African market, we look for defendable niches. Then we either build the company ourselves or partner with founders and world-leading organisations to give it the best chance."
    parts={['seed']}
  />

  <section class="section">
    <div class="wrap two-up">
      {modes.map((m) => (
        <article class="mode">
          <h2>{m.title}</h2>
          <p>{m.body}</p>
          <p class="mode__eg">For example: {m.examples.join(', ')}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section on-mist" aria-labelledby="platform-h">
    <div class="wrap platform">
      <div>
        <p class="label">What founders get</p>
        <h2 id="platform-h">One platform, four things you would otherwise hunt for separately.</h2>
      </div>
      <dl class="platform__list">
        {platform.map((p) => (
          <div>
            <dt>{p.title}</dt>
            <dd>{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="stages-h">
    <div class="wrap">
      <p class="label">Our process</p>
      <h2 id="stages-h" class="stages__h">From idea to a company that runs without us.</h2>
      <ol class="stage-list">
        {stages.map((s, i) => (
          <li class="stage-row">
            <div class="stage-row__art">
              <Mark parts={stageParts[i]} strokeWidth={4} idPrefix={`ap${i}`} class="stage-row__mark" />
            </div>
            <div class="stage-row__head">
              <p class="stage-row__num">Stage {i + 1}</p>
              <h3>{s.title}</h3>
              <p class="stage-row__sum">{s.summary}</p>
            </div>
            <ul class="stage-row__qs">
              {s.questions.map((q) => <li>{q}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section on-dark" aria-labelledby="crit-h">
    <div class="wrap crit">
      <div>
        <p class="label">Who we back</p>
        <h2 id="crit-h">Seven things we look for.</h2>
        <p class="crit__note">
          No team has all seven on day one. We look for founders who have most of them and know
          which ones they are missing.
        </p>
      </div>
      <ol class="crit__list">
        {criteria.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <PitchBand />
</Base>

<style>
  .two-up {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }
  .mode {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .mode h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .mode p {
    color: var(--ink-soft);
    max-width: 44ch;
  }
  .mode__eg {
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--indigo) !important;
  }

  .platform {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }
  .platform h2 {
    font-size: var(--step-3);
    max-width: 16ch;
  }
  .platform__list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2.5rem;
  }
  .platform__list div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .platform__list dt {
    font-size: var(--step-1);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .platform__list dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .stages__h {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .stage-list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .stage-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .stage-row :global(.stage-row__mark) {
    width: 100%;
    height: auto;
  }
  .stage-row__num {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--indigo);
    margin-bottom: 0.4rem;
  }
  .stage-row h3 {
    font-size: var(--step-2);
    font-weight: 320;
    letter-spacing: -0.015em;
  }
  .stage-row__sum {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    max-width: 32ch;
  }
  .stage-row__qs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage-row__qs li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .stage-row__qs li:last-child {
    border-bottom: 0;
  }
  .stage-row__qs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--indigo);
    border-radius: 50%;
  }

  .crit {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem clamp(2rem, 6vw, 6rem);
  }
  .crit h2 {
    font-size: var(--step-3);
    max-width: 12ch;
  }
  .crit__note {
    margin-top: 1.5rem;
    color: var(--on-dark-soft);
    max-width: 34ch;
  }
  .crit__list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: crit;
  }
  .crit__list li {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line-dark);
  }
  .crit__list h3 {
    font-size: 1.15rem;
  }
  .crit__list p {
    color: var(--on-dark-soft);
  }

  @media (max-width: 63.99rem) {
    .platform,
    .crit {
      grid-template-columns: 1fr;
    }
    .stage-row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
    .stage-row__qs {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 47.99rem) {
    .two-up,
    .platform__list {
      grid-template-columns: 1fr;
    }
    .crit__list li {
      grid-template-columns: 1fr;
    }
  }
</style>
