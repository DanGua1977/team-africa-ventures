---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Mark from '../components/Mark.astro';
import { profile, commitments, stages, criteria, focusAreas, bestFor } from '../data/approach';

const stageParts: Array<Array<'seed' | 'founder' | 'partner'>> = [
  ['seed'],
  ['seed', 'founder'],
  ['seed', 'founder', 'partner'],
];
---
<Base title="How we build" description="How Team Africa Ventures builds AI-first companies with founders: our model, what we commit, our three-stage process and what we look for.">
  <PageHero
    label="How we build"
    title="We build inside the company, not beside it."
    intro="Team Africa Ventures is a venture studio. We start before day one, build version one with founders, and fund what works. Every company is AI-first, with a small team and a global market."
    parts={['seed']}
  />

  <section class="section" aria-labelledby="glance-h">
    <div class="wrap split">
      <div>
        <p class="label">At a glance</p>
        <h2 id="glance-h" class="h-section">The short version, for founders comparing partners.</h2>
      </div>
      <dl class="glance">
        {profile.map((p) => (
          <div class="glance__row">
            <dt>{p.term}</dt>
            <dd>{p.detail}</dd>
          </div>
        ))}
        <div class="glance__row">
          <dt>Focus areas</dt>
          <dd>{focusAreas.map((f) => f.title).join(', ')}</dd>
        </div>
        <div class="glance__row">
          <dt>Best for</dt>
          <dd>
            <ul>
              {bestFor.map((b) => <li>{b}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section on-alt" aria-labelledby="commit-h">
    <div class="wrap split">
      <div>
        <p class="label">What we commit</p>
        <h2 id="commit-h" class="h-section">More than a cheque, from the first day.</h2>
      </div>
      <dl class="commit">
        {commitments.map((c) => (
          <div>
            <dt>{c.title}</dt>
            <dd>{c.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="stages-h">
    <div class="wrap">
      <p class="label">Our process</p>
      <h2 id="stages-h" class="h-section">From a weak point in a market to a company that scales without the headcount.</h2>
      <ol class="stage-list">
        {stages.map((s, i) => (
          <li class="stage-row">
            <div class="stage-row__art">
              <Mark parts={stageParts[i]} strokeWidth={4} idPrefix={`ap${i}`} class="stage-row__mark" />
            </div>
            <div>
              <p class="stage-row__num">Stage {i + 1}</p>
              <h3>{s.title}</h3>
              <p class="stage-row__sum">{s.summary}</p>
            </div>
            <ul class="stage-row__qs">
              {s.questions.map((q) => <li>{q}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section on-dark" aria-labelledby="crit-h">
    <div class="wrap split">
      <div>
        <p class="label">Who we build with</p>
        <h2 id="crit-h" class="h-section">Seven things we look for.</h2>
        <p class="crit__note">
          No team has all seven on day one. We look for founders who have most of them and know
          which ones they are missing.
        </p>
      </div>
      <ul class="crit__list">
        {criteria.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .glance {
    margin: 0;
    border-top: 2px solid var(--text);
  }
  .glance__row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: 0.4rem 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }
  .glance dt {
    font-weight: 600;
    color: var(--accent);
  }
  .glance dd {
    margin: 0;
  }
  .glance ul {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.35rem;
  }

  .commit {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .commit div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .commit dt {
    font-size: var(--step-1);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .commit dd {
    margin: 0;
    color: var(--text-soft);
  }

  .stage-list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .stage-row {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .stage-row :global(.stage-row__mark) {
    width: 100%;
    height: auto;
    color: var(--text);
  }
  .stage-row__num {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .stage-row h3 {
    font-size: var(--step-2);
    font-weight: 320;
    letter-spacing: -0.015em;
  }
  .stage-row__sum {
    margin-top: 0.75rem;
    color: var(--text-soft);
    max-width: 32ch;
  }
  .stage-row__qs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage-row__qs li {
    position: relative;
    padding: 0.55rem 0 0.55rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .stage-row__qs li:last-child {
    border-bottom: 0;
  }
  .stage-row__qs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--accent);
    border-radius: 50%;
  }

  .crit__note {
    margin-top: 1.5rem;
    color: var(--text-soft);
    max-width: 34ch;
  }
  .crit__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .crit__list li {
    display: grid;
    grid-template-columns: minmax(10rem, 0.8fr) minmax(0, 1.2fr);
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .crit__list h3 {
    font-size: 1.15rem;
  }
  .crit__list p {
    color: var(--text-soft);
  }

  @media (max-width: 63.99rem) {
    .stage-row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
    .stage-row__qs {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 47.99rem) {
    .commit,
    .crit__list li,
    .glance__row {
      grid-template-columns: 1fr;
    }
  }
</style>
