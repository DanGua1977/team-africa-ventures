---
// Optional closing call to action, then the dark footer.
import { nav, site } from '../data/site';
interface Props {
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
{cta && (
  <section class="cta" aria-labelledby="cta-h">
    <div class="wrap cta__inner">
      <h2 id="cta-h">Know an industry that is ready to be rebuilt?</h2>
      <p class="cta__body">
        Tell us which service you would replace, what you know about it from the inside, and why now.
      </p>
      <div class="cta__actions">
        <a class="btn btn--solid" href="/contact/#founders">Build with us</a>
        <a class="link-arrow" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
)}

<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <p class="site-footer__brand">Team Africa Ventures</p>
        <p class="site-footer__line">
          An operator-led venture studio. We build AI-first companies with founders, with small teams
          and a global market, from {site.city.split(',')[0]}.
        </p>
      </div>
      <nav aria-label="Footer" class="site-footer__nav">
        <h2 class="site-footer__h">Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="site-footer__h">Write to us</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.city}</li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .cta {
    padding-block: var(--section);
    text-align: center;
    border-top: 1px solid var(--line);
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .cta h2 {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .cta__body {
    color: var(--text-soft);
    max-width: 44ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-top: 0.5rem;
  }
  .site-footer {
    padding-block: clamp(4rem, 8vw, 6rem) 2.5rem;
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1fr);
    gap: 2.5rem clamp(2rem, 5vw, 4rem);
    padding-top: 2rem;
    background:
      linear-gradient(var(--line-strong), var(--line-strong)) left top / 8rem 3px no-repeat,
      linear-gradient(var(--line), var(--line)) left 1px / 100% 1px no-repeat;
  }
  .site-footer__brand {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--step-2);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 1rem;
  }
  .site-footer__line {
    color: var(--text-soft);
    max-width: 40ch;
    font-size: 1rem;
  }
  .site-footer__h {
    font-size: 0.95rem;
    margin-bottom: 0.9rem;
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
    font-size: 1rem;
    color: var(--text-soft);
  }
  .site-footer a {
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .site-footer a:hover {
    text-decoration: underline;
    color: var(--ink);
  }
  .site-footer__bottom {
    margin-top: clamp(3rem, 6vw, 4rem);
    padding-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--text-soft);
    background:
      linear-gradient(var(--line-strong), var(--line-strong)) left top / 8rem 3px no-repeat,
      linear-gradient(var(--line), var(--line)) left 1px / 100% 1px no-repeat;
  }
  @media (max-width: 53.99rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
