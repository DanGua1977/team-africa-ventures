---
// Compact navy header for inner pages. The mark sits cropped at the right edge.
import Mark from './Mark.astro';
interface Props {
  label: string;
  title: string;
  intro?: string;
  parts?: Array<'seed' | 'founder' | 'partner'>;
}
const { label, title, intro, parts } = Astro.props;
---
<section class="page-hero on-dark">
  <Mark class="page-hero__mark" strokeWidth={0.8} parts={parts} idPrefix="ph" />
  <div class="wrap page-hero__inner">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {intro && <p class="lede page-hero__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(9rem, 16vw, 12rem);
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }
  .page-hero__inner {
    position: relative;
    z-index: 1;
  }
  .page-hero h1 {
    font-size: var(--step-4);
    font-weight: 260;
    max-width: 16ch;
  }
  .page-hero__intro {
    margin-top: 1.75rem;
    color: var(--text-soft);
  }
  .page-hero :global(.page-hero__mark) {
    position: absolute;
    right: -24vw;
    top: 50%;
    width: min(54rem, 62vw);
    height: auto;
    transform: translateY(-42%);
    color: var(--text);
    opacity: 0.6;
  }
  @media (max-width: 47.99rem) {
    .page-hero :global(.page-hero__mark) {
      right: -45vw;
      width: 115vw;
      opacity: 0.28;
    }
  }
</style>
