---
// Inner-page header: white, typographic, with the two-tone rule and a thin vertical connector.
interface Props {
  label: string;
  title: string;
  intro?: string;
  /** Accepted for compatibility with earlier pages; the editorial header has no artwork. */
  parts?: Array<'seed' | 'founder' | 'partner'>;
}
const { label, title, intro } = Astro.props;
---
<section class="page-hero">
  <div class="wrap page-hero__inner">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    {intro && <p class="lede page-hero__intro">{intro}</p>}
    <slot />
  </div>
  <span class="page-hero__line" aria-hidden="true"></span>
</section>

<style>
  .page-hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(3.5rem, 8vw, 6rem));
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }
  .page-hero h1 {
    font-size: var(--step-4);
    max-width: 18ch;
    letter-spacing: -0.03em;
  }
  .page-hero__intro {
    margin-top: 1.75rem;
  }
  .page-hero__line {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: clamp(2.5rem, 5vw, 4rem);
    background: var(--line-strong);
  }
</style>
