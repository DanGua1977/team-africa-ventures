---
import Logo from './Logo.astro';
import { nav } from '../data/site';
interface Props {
  dark?: boolean;
}
const { dark = true } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---
<header class:list={['site-header', { 'site-header--dark': dark }]}>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__home" aria-label="Team Africa Ventures, home">
      <Logo idPrefix="hdr" />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="menu-toggle__text">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.dataset.open = String(open);
      const text = toggle.querySelector('.menu-toggle__text');
      if (text) text.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    color: var(--navy);
  }
  .site-header--dark {
    color: var(--on-dark);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .site-header__home {
    text-decoration: none;
    color: inherit;
  }
  .site-nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--peach);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before {
    display: block;
    width: 1rem;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .menu-toggle__bars::before {
    content: '';
    position: absolute;
    top: 5px;
  }
  .menu-toggle__bars {
    transform: translateY(-3px);
  }

  @media (max-width: 47.99rem) {
    .menu-toggle {
      display: inline-flex;
    }
    .site-nav {
      position: absolute;
      top: 100%;
      left: var(--gutter);
      right: var(--gutter);
      display: none;
      padding: 1.25rem 1.5rem;
      background: var(--navy-deep);
      color: var(--on-dark);
      border: 1px solid var(--line-dark);
      border-radius: 16px;
    }
    .site-nav[data-open='true'] {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      gap: 0.25rem;
    }
    .site-nav a {
      display: block;
      font-size: 1.25rem;
      padding-block: 0.6rem;
    }
  }
</style>
