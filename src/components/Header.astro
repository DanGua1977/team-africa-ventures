---
import Logo from './Logo.astro';
import { nav } from '../data/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === href.replace(/\/$/, '');
---
<header class="site-header" data-scrolled="false">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__home" aria-label="Team Africa Ventures, home">
      <Logo idPrefix="hdr" />
    </a>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-nav__cta-mobile"><a href="/contact/#founders">Build with us</a></li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Dark theme">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" />
        </svg>
      </button>
      <a class="btn btn--cta site-header__cta" href="/contact/#founders">Build with us</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="menu-toggle__text">Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => {
    if (header) header.dataset.scrolled = String(window.scrollY > 24);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme: follows the system until the reader chooses; the choice is remembered.
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDark.matches);
  const sync = () => themeBtn?.setAttribute('aria-pressed', String(isDark()));
  sync();
  systemDark.addEventListener('change', sync);
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('tav-theme', next);
    } catch {}
    sync();
  });

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.getElementById('site-nav');
  if (toggle && navEl) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.dataset.open = String(open);
      const text = toggle.querySelector('.menu-toggle__text');
      if (text) text.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color-scheme: dark;
    color: #fff;
    transition:
      background-color 220ms ease,
      backdrop-filter 220ms ease,
      border-color 220ms ease;
    border-bottom: 1px solid transparent;
    view-transition-name: site-header;
  }
  .site-header[data-scrolled='true'] {
    background: color-mix(in srgb, var(--night) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .site-header__home {
    text-decoration: none;
    color: inherit;
    margin-right: auto;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    font-size: 1rem;
    font-weight: 520;
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: border-color 160ms ease;
  }
  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--peach);
  }
  .site-nav__cta-mobile {
    display: none;
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .btn--cta {
    min-height: 2.75rem;
    padding: 0.5rem 1.2rem;
    background: var(--peach);
    color: var(--night);
  }
  .btn--cta:hover {
    background: var(--peach-hi);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: #fff;
  }
  .theme-toggle[aria-pressed='true'] svg {
    transform: rotate(180deg);
  }
  .theme-toggle svg {
    transition: transform 240ms ease;
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before {
    display: block;
    width: 1rem;
    height: 1px;
    background: currentColor;
    position: relative;
  }
  .menu-toggle__bars::before {
    content: '';
    position: absolute;
    top: 5px;
  }
  .menu-toggle__bars {
    transform: translateY(-3px);
  }

  @media (max-width: 63.99rem) {
    .site-nav ul {
      gap: 1.4rem;
    }
  }
  @media (max-width: 53.99rem) {
    .menu-toggle {
      display: inline-flex;
    }
    .site-header__cta {
      display: none;
    }
    .site-nav {
      position: absolute;
      top: calc(100% - 0.25rem);
      left: var(--gutter);
      right: var(--gutter);
      display: none;
      padding: 1.25rem 1.5rem;
      background: var(--night-2);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 18px;
      box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.5);
    }
    .site-nav[data-open='true'] {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }
    .site-nav a {
      display: block;
      font-size: 1.25rem;
      padding-block: 0.6rem;
    }
    .site-nav__cta-mobile {
      display: block;
    }
    .site-nav__cta-mobile a {
      color: var(--peach);
    }
  }
</style>
